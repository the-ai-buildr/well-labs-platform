# ── Supabase ───────────────────────────────────────────────────────────────
# Set on the Vercel project (`vercel env add`). Pull locally with:
#   vercel env pull .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SECRET_KEY=

# Pulled by `vercel env pull`; authenticates Vercel services (e.g. AI Gateway) locally.
VERCEL_OIDC_TOKEN=

# Postgres for the app (often Supabase transaction pooler, port 6543).
DATABASE_URL=
# Optional: session pooler (5432) or direct URL for `pnpm db:pull` / `db:studio`.
# If unset, drizzle.config.ts upgrades pooler :6543 → :5432 automatically.
# DATABASE_URL_DRIZZLE=
