# ── App data (Supabase via Vercel Marketplace) ─────────────────────────────
# Injected automatically once the Supabase integration is connected to the
# Vercel project. Pull locally with: vercel env pull .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SECRET_KEY=

# ── Platform access (Supabase OAuth app via Vercel Connect) ────────────────
# Connector UID printed by `vercel connect create`. The OAuth client id/secret
# live inside Vercel Connect, not in this file.
SUPABASE_CONNECT_CONNECTOR=
# Pulled by `vercel env pull`; lets @vercel/connect authenticate locally.
VERCEL_OIDC_TOKEN=
